includeConfig "${projectDir}/external/nf-helper/conf/sites/raven.config"

profiles {
    raven {
        process {
            // validate_taxa.py expands the complete NCBI taxdump JSON into
            // several Python indexes. Leave headroom above its observed peak.
            withName: VALIDATE_TAXA {
                memory = 16.GB
            }

            // SingleM benefits from Raven's two hardware threads per physical
            // core. The first attempt uses 32 physical cores; retries may use
            // 64 and then all 72 physical cores on one node.
            withName: SINGLEM {
                clusterOptions = '--export=ALL --ntasks-per-core=2'
                cpus = { Math.min(64 * task.attempt, params.raven_max_cpus_ht as int) }
                time = {
                    def requestedTime = task.attempt == 1 ? 4.h : task.attempt == 2 ? 12.h : 24.h
                    [requestedTime, params.resource_time_limit()].min()
                }
                resourceLimits = [
                    memory: 2048000.MB,
                    cpus: params.raven_max_cpus_ht as int,
                    time: 24.h,
                ]
            }

            // Exact process selectors take precedence over the generic CPU
            // settings in nextflow.config. Match Raven's 18-core/125-GB ratio
            // for each requested A100.
            withName: 'COMEBIN_GPU|VAMB_GPU|LORBIN_GPU' {
                cpus = { 18 * (params.gpus as int) }
                resourceLimits = [
                    memory: 125000.MB * (params.gpus as int),
                    cpus: 18 * (params.gpus as int),
                    time: 24.h,
                ]
            }

            withName: 'DOWNLOAD_SRA_METADATA|RESOLVE_SRR_METADATA|SANDPIPER' {
                executor = 'local'
                cpus = 1
                memory = 16.GB
                time = 24.h
                scratch = false
                resourceLimits = [
                    memory: 16.GB,
                    cpus: 1,
                    time: 24.h,
                ]
            }

            // Raven batch jobs have no internet access. Resource allocation
            // remains the pipeline-wide I/O-oriented DOWNLOAD_SRR policy.
            withName: DOWNLOAD_SRR {
                executor = 'local'
                scratch = false
            }
        }
    }
}
