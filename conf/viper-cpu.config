includeConfig "${projectDir}/external/nf-helper/conf/sites/viper-cpu.config"

profiles {
    'viper-cpu' {
        process {
            // validate_taxa.py expands the complete NCBI taxdump JSON into
            // several Python indexes. Leave headroom above its observed peak.
            withName: VALIDATE_TAXA {
                memory = 16.GB
            }

            // Viper allocates one usable thread per physical core by default
            // while accounting for both SMT siblings. Make both siblings usable
            // for SingleM and pass the resulting logical-CPU count to --threads.
            // The 128-thread cap therefore occupies at most 64 physical cores
            // and remains eligible for Viper's shared small partition.
            withName: SINGLEM {
                clusterOptions = '--export=ALL --ntasks-per-core=2'
                cpus = { Math.min(64 * task.attempt, params.max_cpus as int) }
                time = {
                    def requestedTime = task.attempt == 1 ? 4.h : task.attempt == 2 ? 12.h : 24.h
                    [requestedTime, params.resource_time_limit()].min()
                }
            }

            withName: 'DOWNLOAD_SRA_METADATA|RESOLVE_SRR_METADATA|SANDPIPER' {
                executor = 'local'
                cpus = 1
                memory = 16.GB
                time = 24.h
                scratch = false
                resourceLimits = [
                    memory: 16.GB,
                    cpus: 1,
                    time: 24.h,
                ]
            }

            // Viper compute nodes have no internet access. Only placement is
            // site-specific; resource allocation comes from nextflow.config.
            withName: DOWNLOAD_SRR {
                executor = 'local'
                scratch = false
            }
        }
    }
}
