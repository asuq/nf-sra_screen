includeConfig "${projectDir}/external/nf-helper/conf/sites/viper-cpu.config"

profiles {
    'viper-cpu' {
        process {
            // validate_taxa.py expands the complete NCBI taxdump JSON into
            // several Python indexes. Leave headroom above its observed peak.
            withName: VALIDATE_TAXA {
                memory = 16.GB
            }

            withName: 'DOWNLOAD_SRA_METADATA|RESOLVE_SRR_METADATA|DOWNLOAD_SRR' {
                executor = 'local'
                cpus = 1
                memory = 16.GB
                time = 24.h
                scratch = false
                resourceLimits = [
                    memory: 16.GB,
                    cpus: 1,
                    time: 24.h,
                ]
            }
        }
    }
}
