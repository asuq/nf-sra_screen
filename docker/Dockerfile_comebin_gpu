FROM condaforge/miniforge3:26.3.2-3@sha256:95195a50e20f7929a31a68ea407cefe117423258639efb6b66f0518e4b86f8ee

ARG CONDA_ENV_NAME='comebin'

ENV CONDA_DIR=/opt/conda \
    MAMBA_NO_BANNER=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATH=$CONDA_DIR/envs/$CONDA_ENV_NAME/bin:$PATH

WORKDIR /work

RUN mamba create -y -n "${CONDA_ENV_NAME}" \
    -c conda-forge -c bioconda \
    "python=3.7" \
    "comebin=1.0.4" \
    "pip" \
    && pip install --no-cache-dir --force-reinstall \
      --index-url https://download.pytorch.org/whl/cu117 \
      "torch==1.13.1" \
    && mamba clean --all --yes

RUN python - <<'PY'
"""Validate that the image contains CUDA-enabled PyTorch."""
import torch

assert torch.__version__.startswith("1.13.1"), torch.__version__
assert torch.version.cuda == "11.7", torch.version.cuda
print(f"torch={torch.__version__} cuda={torch.version.cuda}")
PY

CMD ["/bin/bash"]
