FROM condaforge/miniforge3:26.3.2-3@sha256:95195a50e20f7929a31a68ea407cefe117423258639efb6b66f0518e4b86f8ee

ARG CONDA_ENV_NAME='lorbin'
ARG LORBIN_REF='e35c65b3a97fe225b04dc0beaddb85fcc4a1af7c'

ENV CONDA_DIR=/opt/conda \
    MAMBA_NO_BANNER=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATH=$CONDA_DIR/envs/$CONDA_ENV_NAME/bin:$PATH

WORKDIR /work

RUN mamba create -y -n "${CONDA_ENV_NAME}" \
    -c conda-forge -c bioconda \
    "python=3.10" \
    "biopython=1.81" \
    "hmmer=3.1b2" \
    "prodigal=2.6.3" \
    "bedtools=2.26.0" \
    "samtools=1.15.1" \
    "mkl<2024" \
    "numpy=1.23.3" \
    "pip=22.2.2" \
    "git" \
    && mamba clean --all --yes

RUN pip install --no-cache-dir \
      "pandas==2.2.2" \
      "scikit-learn==1.1.2" \
      "scipy==1.13.1" \
      "joblib==1.4.2" \
      "git+https://github.com/LorMeBioAI/LorBin.git@${LORBIN_REF}"

RUN pip install --no-cache-dir --force-reinstall \
      --index-url https://download.pytorch.org/whl/cu124 \
      "torch==2.6.0" \
    && pip check

RUN python - <<'PY'
"""Validate the compatibility-frozen LorBin GPU stack."""
from importlib.metadata import version

import lorbin
import torch

assert version("biopython") == "1.81", version("biopython")
assert version("numpy") == "1.23.3", version("numpy")
assert version("pandas") == "2.2.2", version("pandas")
assert version("scikit-learn") == "1.1.2", version("scikit-learn")
assert version("scipy") == "1.13.1", version("scipy")
assert torch.__version__.startswith("2.6.0"), torch.__version__
assert torch.version.cuda == "12.4", torch.version.cuda
print(f"lorbin={lorbin.__file__} torch={torch.__version__} cuda={torch.version.cuda}")
PY

CMD ["/bin/bash"]
