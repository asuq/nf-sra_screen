// --------------------------- Parameters -------------------------------------
params {
  // Required parameters
  sra           = null
  fastq_tsv     = null
  binning_tsv   = null
  assembler     = null
  assemblers    = 'auto'

  // Optional parameters
  taxdump       = null
  uniprot_db    = null
  taxa          = null
  gtdb_ncbi_map = null
  sandpiper_db  = null
  singlem_db    = null
  checkm2_db    = null
  noassembly    = false
  binning       = false
  binners       = 'all-compatible'
  refiners      = 'binette'
  semibin_environment = 'global'
  gpu           = false

  // Misc
  help        = false
  version     = '0.4.0'
  outdir      = 'output'
  max_retries = 3

  // Resource parameters
  max_cpus              = 4
  max_memory            = 8.GB
  max_time              = 24.h
  download_srr_max_forks = 2
  resource_memory_limit = { nextflow.util.MemoryUnit.of(params.max_memory.toString()) }
  resource_time_limit   = { nextflow.util.Duration.of(params.max_time.toString()) }

  // Optional scheduler parameters
  queue_short            = null
  queue_standard         = null
  queue_highmem          = null
  queue_gpu              = null
  gpu_type               = null
  gpus                   = 1
  executor_queue_size    = null
  slurm_cluster_options  = null
  gpu_cluster_options    = null
  apptainer_cache_dir    = null
  apptainer_run_options  = null
  apptainer_pull_timeout = null
  singularity_cache_dir  = null
  singularity_run_options = null
  singularity_pull_timeout = null
  gpu_container_options  = null
}

// -=---------------=---------- Environment -----------------------------------
manifest {
  nextflowVersion = '>=26.04.6'
}

cleanup = false

// ---------------------------- Containers ------------------------------------
process {
  errorStrategy = { task.attempt <= params.max_retries ? 'retry' : 'ignore' }
  maxRetries    = params.max_retries
  maxErrors     = -1

  // shell = ['/bin/bash', '-euo', 'pipefail']

  withLabel: assembly {
    maxForks = 10
  }

  withLabel: binning {
    maxForks = 10
  }

  withLabel: gpu {
    maxForks = 10
    clusterOptions = {
      [
        params.slurm_cluster_options ?: null,
        params.gpu_cluster_options ?: null,
      ]
        .findAll { option -> option != null && option.toString().trim() }
        .join(' ')
    }
    containerOptions = {
      [
        params.apptainer_run_options ?: params.singularity_run_options ?: null,
        params.gpu_container_options ?: null,
      ]
        .findAll { option -> option != null && option.toString().trim() }
        .join(' ')
    }
  }

  withName: VALIDATE_TAXA {
    errorStrategy = 'terminate'
    container = "quay.io/asuq1617/nf-sra_screen_taxa:0.4.0@sha256:6366a34b26b324e1de543b26bb9d91799433ccddea254e0e8e29c32ca964ba44"
    cpus   = { Math.min( 1 * task.attempt, params.max_cpus as int ) }
    memory = { [ 4.GB * task.attempt, params.resource_memory_limit() ].min() }
    time   = { [ 10.min * task.attempt, params.resource_time_limit() ].min() }
  }

  withName: DOWNLOAD_SRA_METADATA {
    container = "quay.io/asuq1617/iseq:1.9.8-sratools3.4.1-r1@sha256:59e96013353dbecddf483aac16591c591b429219b7857a9b277c3bfcb1060ed1"
    maxForks = 10
    cpus   = { Math.min( 1 * task.attempt, params.max_cpus as int ) }
    memory = { [ 4.GB * task.attempt, params.resource_memory_limit() ].min() }
    time   = { [ 1.h * task.attempt, params.resource_time_limit() ].min() }
  }

  withName: RESOLVE_SRR_METADATA {
    container = "quay.io/asuq1617/iseq:1.9.8-sratools3.4.1-r1@sha256:59e96013353dbecddf483aac16591c591b429219b7857a9b277c3bfcb1060ed1"
    maxForks = 10
    cpus   = { Math.min( 1 * task.attempt, params.max_cpus as int ) }
    memory = { [ 1.GB * task.attempt, params.resource_memory_limit() ].min() }
    time   = { [ 10.min * task.attempt, params.resource_time_limit() ].min() }
  }

  withName: SANDPIPER {
    container = "quay.io/biocontainers/singlem:0.21.3--pyhdfd78af_0@sha256:c01b406761e9453ad1a779a01270d60105b8c9e66691790a611ac0dd7a5fbc8a"
    cpus   = { Math.min( 1 * task.attempt, params.max_cpus as int ) }
    memory = { [ 4.GB * task.attempt, params.resource_memory_limit() ].min() }
    time   = { [ 10.min * task.attempt, params.resource_time_limit() ].min() }
  }

  withName: DOWNLOAD_SRR {
    container = "quay.io/asuq1617/iseq:1.9.8-sratools3.4.1-r1@sha256:59e96013353dbecddf483aac16591c591b429219b7857a9b277c3bfcb1060ed1"
    // Network concurrency is independent of the task CPU request. Keep the
    // allocation fixed across retries; sample depth primarily changes transfer
    // volume, temporary storage, and elapsed time rather than required CPUs.
    maxForks = params.download_srr_max_forks as int
    cpus   = 1
    memory = { [ 8.GB, params.resource_memory_limit() ].min() }
    time   = { params.resource_time_limit() }
  }

  withName: SINGLEM {
    container = "quay.io/biocontainers/singlem:0.21.3--pyhdfd78af_0@sha256:c01b406761e9453ad1a779a01270d60105b8c9e66691790a611ac0dd7a5fbc8a"
    cpus   = { Math.min( 32 * task.attempt, params.max_cpus as int ) }
    memory = { [ 64.GB * task.attempt, params.resource_memory_limit() ].min() }
    time   = { [ 2.h * task.attempt, params.resource_time_limit() ].min() }
  }

  withName: FASTP_SHORT {
