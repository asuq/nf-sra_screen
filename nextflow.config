  }

  withName: BLOBTOOLS {
    container = "docker.io/genomehubs/blobtoolkit:4.5.0@sha256:8cf4b10ebf255d8cc9eb8076c93377450f69d370e07915f7b9d4f23348d0b7ef"
    cpus   = { Math.min( 16, params.max_cpus as int ) }
    memory = { [ 50.GB, params.resource_memory_limit() ].min() }
